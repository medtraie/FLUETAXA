{
  "entities": {
    "Tank": {
      "title": "Tank",
      "description": "Fuel storage tank",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "site": { "type": "string" },
        "fuelType": { "type": "string", "enum": ["gasoil", "essence"] },
        "capacity": { "type": "number" },
        "currentLevel": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "site", "fuelType", "capacity", "currentLevel"]
    },
    "FuelSupply": {
      "title": "Fuel Supply",
      "description": "Recording of fuel tank replenishment",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "quantity": { "type": "number" },
        "supplier": { "type": "string" },
        "site": { "type": "string" },
        "fuelType": { "type": "string" },
        "tankId": { "type": "string" }
      },
      "required": ["date", "quantity", "supplier", "site", "fuelType", "tankId"]
    },
    "FuelUsage": {
      "title": "Fuel Usage",
      "description": "Recording of fuel consumption by a vehicle",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "quantity": { "type": "number" },
        "agentId": { "type": "string" },
        "agentName": { "type": "string" },
        "vehicleId": { "type": "string" },
        "chassisNumber": { "type": "string" },
        "site": { "type": "string" },
        "fuelType": { "type": "string" },
        "mileage": { "type": "number" }
      },
      "required": ["date", "quantity", "agentId", "vehicleId", "chassisNumber", "site", "fuelType"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Vehicle in the fleet",
      "type": "object",
      "properties": {
        "chassisNumber": { "type": "string" },
        "brand": { "type": "string", "enum": ["Skoda", "Volkswagen", "Seat", "Cupra", "Audi", "Porsche", "Bentley", "Autre"] },
        "addedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chassisNumber", "brand"]
    },
    "Agent": {
      "title": "Agent",
      "description": "System user/agent",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "agent"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "registeredDeviceId": { "type": "string" },
        "deviceDescription": { "type": "string" },
        "permissions": {
          "type": "object",
          "properties": {
            "sites": { "type": "array", "items": { "type": "string" } },
            "fuelTypes": { "type": "array", "items": { "type": "string" } },
            "brands": { "type": "array", "items": { "type": "string" } },
            "allowUnregisteredChassis": { "type": "boolean" },
            "monthlyLimit": { "type": "number" },
            "fillLimit": { "type": "number" },
            "groupIds": { "type": "array", "items": { "type": "string" } },
            "specificVehicleIds": { "type": "array", "items": { "type": "string" } },
            "excludedVehicleIdsFromGroups": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["uid", "firstName", "lastName", "role", "status"]
    },
    "VehicleGroup": {
      "title": "Vehicle Group",
      "description": "Groups of vehicles with specific fuel limits and permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "vehicleIds": { "type": "array", "items": { "type": "string" } },
        "agentIds": { "type": "array", "items": { "type": "string" } },
        "fuelLimit": { "type": "number" },
        "limitPeriod": { "type": "string", "enum": ["day", "week", "month"] },
        "isCumulable": { "type": "boolean" },
        "frequency": { "type": "string", "enum": ["once", "once_per_day", "once_per_week", "once_per_month"] },
        "sites": { "type": "array", "items": { "type": "string" } },
        "fuelTypes": { "type": "array", "items": { "type": "string" } },
        "isKmRequired": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "vehicleIds", "agentIds", "fuelLimit", "limitPeriod", "isCumulable", "frequency", "sites", "fuelTypes", "isKmRequired", "createdAt"]
    },
    "Voucher": {
      "title": "Voucher",
      "description": "Fuel voucher/ticket with QR code",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "liters": { "type": "number" },
        "authorizedVehicleIds": { "type": "array", "items": { "type": "string" } },
        "isOpen": { "type": "boolean" },
        "validity": { "type": "string", "enum": ["1_month", "2_months", "1_year", "unlimited"] },
        "expirationDate": { "type": "string", "format": "date-time" },
        "isSellable": { "type": "boolean" },
        "status": { "type": "string", "enum": ["created", "used", "expired", "valid_unused", "suspended"] },
        "fuelTypes": { "type": "array", "items": { "type": "string" } },
        "sites": { "type": "array", "items": { "type": "string" } },
        "creationDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "usedAt": { "type": "string", "format": "date-time" },
        "usedBy": { "type": "string" }
      },
      "required": ["id", "code", "liters", "authorizedVehicleIds", "isOpen", "validity", "isSellable", "status", "fuelTypes", "sites", "createdAt"]
    }
  },
  "firestore": {
    "/tanks/{tankId}": {
      "schema": "Tank",
      "description": "Fuel tanks"
    },
    "/fuel_supplies/{supplyId}": {
      "schema": "FuelSupply",
      "description": "Fuel supply logs"
    },
    "/fuel_usages/{usageId}": {
      "schema": "FuelUsage",
      "description": "Fuel usage logs"
    },
    "/vehicles/{chassisNumber}": {
      "schema": "Vehicle",
      "description": "Vehicles fleet"
    },
    "/agents/{uid}": {
      "schema": "Agent",
      "description": "Agents registry"
    },
    "/vehicle_groups/{groupId}": {
      "schema": "VehicleGroup",
      "description": "Vehicle groups and permissions"
    },
    "/vouchers/{voucherId}": {
      "schema": "Voucher",
      "description": "Fuel vouchers"
    }
  }
}
